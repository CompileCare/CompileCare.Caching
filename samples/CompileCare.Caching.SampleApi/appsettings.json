{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "CacheSettings": {
    "UseRedis": true,
    "RedisConnection": "redis:6379",
    "DefaultExpirationSeconds": 300,
    "LocalCacheExpirationSeconds": 120
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379,abortConnect=false"
  },
  "Caching": {
    "DefaultTtlSeconds": 60,
    "EnableRedis": true
  }
}
