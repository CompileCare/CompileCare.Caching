{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "CacheSettings": {
    "UseRedis": true,
    "RedisConnection": "redis:6379",
    "KeyPrefix": "heapcare-sample",
    "DefaultExpirationSeconds": 300,
    "LocalCacheExpirationSeconds": 120
  },
  "AllowedHosts": "*"
}